{
    "name": "sea-salt-scorekeeper",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "test": "jest",
        "test:components": "jest --config jest.config.components.js",
        "test:coverage": "jest --coverage",
        "test:e2e": "maestro test e2e/",
        "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
        "check:deadcode": "knip"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "2.2.0",
        "@sentry/react-native": "^8.6.0",
        "expo": "~54.0.0",
        "expo-constants": "~18.0.13",
        "expo-linking": "~8.0.11",
        "expo-router": "~6.0.23",
        "expo-status-bar": "~3.0.9",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.16.0",
        "react-native-svg": "15.12.1",
        "react-native-web": "^0.21.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "^29.5.0",
        "@types/react": "~19.1.0",
        "@types/react-test-renderer": "^19.1.0",
        "fast-check": "^4.0.0",
        "jest": "^29.7.0",
        "jest-expo": "^55.0.11",
        "knip": "^6.11.0",
        "prettier": "^3.8.3",
        "react-test-renderer": "^19.1.0",
        "sharp": "^0.34.5",
        "ts-jest": "^29.3.0",
        "typescript": "~5.8.0"
    },
    "private": true
}
